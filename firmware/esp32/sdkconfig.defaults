# Bluetooth LE only (Bluedroid), no Classic
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_SMP_ENABLE=y

# UART0 carries the hub protocol: keep logs and the console off it.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y

# Several Bluetooth hosts connected at once (phone, tablet, ...)
CONFIG_BTDM_CTRL_BLE_MAX_CONN=4
CONFIG_BT_ACL_CONNECTIONS=4

# 1 ms ticks: the mouse pacing in main.c relies on short delays meaning what they say.
CONFIG_FREERTOS_HZ=1000
