# Copy to .env (gitignored) and adjust. Everything machine-specific or secret lives here; the code only has
# generic defaults. Read by the hub/GUI/tools (hub/env.py), the shell tools (tools/env.sh), the Android
# build (android/app/build.gradle.kts) and the firmware builds (firmware/settings.cmake, via the tools).
# Variables already set in the environment take precedence.

# --- Hub ------------------------------------------------------------------------------------------------
# The ESP32 router's serial port. Prefer the stable /dev/serial/by-id/... name.
SWITCHER_SERIAL_PORT=/dev/ttyUSB0
# Ports the hub listens on: agents (mutual TLS) and pairing/agent download (only while pairing is open).
SWITCHER_API_PORT=47110
SWITCHER_PAIRING_PORT=47111
# The switch hotkey: modifiers (ctrl, shift, alt, meta) + an evdev key name.
SWITCHER_HOTKEY=ctrl+scrolllock
# Keyboard layout of the Windows machine when the Pico types the agent installer: us or uk.
SWITCHER_INSTALL_LAYOUT=us
# Address handed to agents during pairing; empty = pick the LAN address automatically (VPN tunnels skipped).
SWITCHER_HUB_ADDRESS=
# Where the hub keeps its config, keys, paired agents and agent builds (default ~/.config/pi-switcher-hub).
SWITCHER_CONFIG_DIR=
# Build caches (default ~/.cache/pi-switcher-hub).
SWITCHER_CACHE_DIR=

# --- Hardware (firmware is built with these; the hub must use the same values) -------------------------------
# USB VID:PID of the Pico. The default is the pid.codes test ID (private use only).
SWITCHER_USB_ID=1209:0001
SWITCHER_USB_MANUFACTURER=pi-switcher-hub
SWITCHER_USB_PRODUCT=Switcher Hub
# Bluetooth name the ESP32 advertises (what phones show when pairing).
SWITCHER_BLE_NAME=Switcher Hub
# Serial speed of the hub <-> ESP32 <-> Pico link.
SWITCHER_LINK_BAUD=921600
# UART wiring (GPIO numbers): Pico TX/RX and ESP32 TX/RX towards the Pico.
SWITCHER_PICO_LINK_TX_PIN=0
SWITCHER_PICO_LINK_RX_PIN=1
SWITCHER_ESP32_PICO_TX_PIN=16
SWITCHER_ESP32_PICO_RX_PIN=17
# Baud rate used to flash the ESP32.
SWITCHER_FLASH_BAUD=921600

# --- Toolchains ------------------------------------------------------------------------------------------
# ESP-IDF checkout (ESP32 firmware), e.g. ~/esp/esp-idf-v6.0.3 — use an absolute path.
IDF_PATH=
# Android SDK and a JDK 17/21 (the Android build tools don't run on newer Java).
ANDROID_HOME=
JAVA_HOME=
# Embeddable Python bundled into the Windows agent (a release that has an "embed-amd64" zip).
SWITCHER_WINDOWS_PYTHON=3.13.16

# --- Android app -----------------------------------------------------------------------------------------
# Application ID on the devices (changing it later installs a separate app).
SWITCHER_ANDROID_APP_ID=dev.switcher.app
# Signing key: created on the first build if missing. Keep the file and the password — Android only installs
# updates signed with the same key. Default keystore: $SWITCHER_CONFIG_DIR/android-signing.p12
SWITCHER_KEYSTORE=
SWITCHER_KEYSTORE_PASSWORD=
SWITCHER_KEY_ALIAS=switcher
